// Organization-owned records carry organizationId directly or inherit scope
// through an organization-scoped parent. InternshipPosition inherits its scope
// from InternshipProgram, so position queries must use program.organizationId.
// Application authorization must also scope reads/writes to that tenant.
// Credentials, refresh tokens, payment references, and document contents are
// stored as hashes or external object-storage references, never as plaintext
// secrets or blobs. The UserRole NULL-scope uniqueness and the one-open-key-
// checkout rule are enforced by partial indexes in the full-database migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  SYSTEM_ADMIN
  DEPARTMENT_COORDINATOR
  INTERNSHIP_OFFICER
  DORMITORY_ADMINISTRATOR
  STUDENT_UNION_COORDINATOR
  FINANCIAL_OFFICE
  UNIVERSITY_ADVISOR
  STUDENT
  COMPANY_HR
  COMPANY_ADVISOR
}

enum PermissionName {
  MANAGE_USERS
  MANAGE_ROLES
  MANAGE_ORGANIZATIONS
  VIEW_STUDENTS
  MANAGE_INTERNSHIPS
  MANAGE_APPLICATIONS
  MANAGE_SUBMISSIONS
  MANAGE_EVALUATIONS
  MANAGE_FINANCE
  MANAGE_DORMITORY
  MANAGE_COMMUNICATION
  MANAGE_SETTINGS
  MANAGE_ORGANIZATION_SETTINGS
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum OrganizationType {
  UNIVERSITY
  COMPANY
  STUDENT_UNION
  FINANCIAL_OFFICE
  DORMITORY
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum InternshipStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  REVIEW_REQUIRED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  TERMINATED
  WITHDRAWN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum AllocationStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum KeyCheckoutStatus {
  CHECKED_OUT
  RETURNED
  LOST
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum SupportStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
  CANCELLED
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PresentationStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AIJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AIJobType {
  CV_EXTRACTION
  SKILL_ANALYSIS
  MATCHING
  RECOMMENDATION
  SKILL_GAP
  SUMMARIZATION
}

model User {
  id                          String                     @id @default(cuid())
  email                       String                     @unique @db.Text
  phone                       String?                    @db.Text
  passwordHash                String                     @db.Text
  firstName                   String                     @db.Text
  lastName                    String                     @db.Text
  status                      UserStatus                 @default(ACTIVE)
  legacyStatus                String?                    @db.Text
  /// Legacy compatibility field retained during the initial schema expansion.
  isActive                    Boolean                    @default(true)
  emailVerifiedAt             DateTime?
  lastLoginAt                 DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  deletedAt                   DateTime?
  roles                       UserRole[]
  memberships                 OrganizationMember[]
  refreshTokens               RefreshToken[]
  loginSessions               LoginSession[]
  studentProfile              StudentProfile?
  companyProfile              CompanyProfile?
  sentOrgInvites              OrganizationInvitation[]   @relation("OrgInviteSender")
  receivedOrgInvites          OrganizationInvitation[]   @relation("OrgInviteRecipient")
  departmentAdvisories        DepartmentAdvisor[]
  programsCreated             InternshipProgram[]        @relation("ProgramCreator")
  applicationsSubmitted       Application[]              @relation("ApplicationSubmitter")
  applicationStatusChanges    ApplicationStatusHistory[] @relation("ApplicationStatusChanger")
  interviews                  Interview[]                @relation("InterviewInterviewer")
  interviewsInvited           Interview[]                @relation("InterviewInvitee")
  invitationsSent             Invitation[]               @relation("InvitationSender")
  invitationsReceived         Invitation[]               @relation("InvitationRecipient")
  advisorAssignments          AdvisorAssignment[]
  tasksAssigned               TeamTask[]                 @relation("TaskAssignee")
  tasksCreated                TeamTask[]                 @relation("TaskCreator")
  taskComments                TaskComment[]
  reviewComments              ReviewComment[]            @relation("ReviewCommentAuthor")
  generatedDocumentsRequested GeneratedDocument[]        @relation("GeneratedDocumentRequester")
  meetingsCreated             Meeting[]                  @relation("MeetingCreator")
  meetingParticipations       MeetingParticipant[]
  documentGrantsReceived      DocumentAccessGrant[]      @relation("GrantRecipient")
  documentGrantsCreated       DocumentAccessGrant[]      @relation("GrantCreator")
  documentVerifications       DocumentVerification[]     @relation("DocumentVerifier")
  officialDocumentsIssued     OfficialDocument[]         @relation("OfficialDocumentIssuer")
  documentsOwned              Document[]                 @relation("DocumentOwner")
  presentationsScheduled      PresentationSchedule[]     @relation("PresentationScheduler")
  panelMemberships            PresentationPanelMember[]
  dormitoriesManaged          Dormitory[]
  keysCheckedOut              KeyCheckout[]
  supportRequestsReviewed     FinancialSupportRequest[]  @relation("SupportReviewer")
  notifications               Notification[]
  notificationPreference      NotificationPreference?
  conversationsCreated        Conversation[]
  conversationMemberships     ConversationParticipant[]
  messages                    Message[]
  reportsCreated              ReportDefinition[]
  auditEvents                 AuditLog[]
  cvExtractions               CVExtraction[]
  skillAssessments            SkillAssessment[]          @relation("AssessmentReviewer")
  aiJobsRequested             AIJob[]

  @@index([status, deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  name        PermissionName   @unique
  description String?          @db.Text
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id             String        @id @default(cuid())
  userId         String
  roleId         String
  organizationId String?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([organizationId, roleId])
  @@index([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Organization {
  id                    String                     @id @default(cuid())
  name                  String                     @db.Text
  slug                  String                     @unique @db.Text
  type                  OrganizationType
  legacyType            String?                    @db.Text
  description           String?                    @db.Text
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deletedAt             DateTime?
  members               OrganizationMember[]
  departments           Department[]
  userRoles             UserRole[]
  university            University?
  companyProfiles       CompanyProfile[]
  invitations           OrganizationInvitation[]
  settings              OrganizationSetting[]
  internshipPrograms    InternshipProgram[]
  applications          Application[]
  placements            Placement[]
  eligibilityRules      EligibilityRule[]
  teams                 InternshipTeam[]
  meetings              Meeting[]
  documentationPlans    DocumentationPlan[]
  milestones            ImplementationMilestone[]
  submissions           Submission[]
  rubrics               EvaluationRubric[]
  documents             Document[]
  officialDocuments     OfficialDocument[]
  generatedDocuments    GeneratedDocument[]
  presentationSchedules PresentationSchedule[]
  finalResults          FinalResult[]
  dormitories           Dormitory[]
  mealCards             MealCard[]
  supportRequests       FinancialSupportRequest[]
  payments              Payment[]
  notifications         Notification[]
  conversations         Conversation[]
  reports               ReportDefinition[]
  auditLogs             AuditLog[]
  cvExtractions         CVExtraction[]
  skillAssessments      SkillAssessment[]
  recommendations       InternshipRecommendation[]
  aiJobs                AIJob[]

  @@index([type, deletedAt])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String?
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, leftAt])
}

model Department {
  id             String              @id @default(cuid())
  organizationId String
  name           String              @db.Text
  code           String?             @db.Text
  description    String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  students       StudentProfile[]
  programs       AcademicProgram[]
  advisors       DepartmentAdvisor[]

  @@unique([organizationId, name])
  @@index([organizationId, code])
  @@index([organizationId])
}

model StudentProfile {
  id               String                     @id @default(cuid())
  userId           String                     @unique
  universityId     String?
  departmentId     String?
  programId        String?
  /// Legacy fields retained so existing profile data is not discarded.
  universityName   String?
  degreeProgram    String?
  studentNumber    String?                    @db.Text
  yearOfStudy      Int?
  gpa              Float?                     @db.DoublePrecision
  bio              String?                    @db.Text
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  user             User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  university       University?                @relation(fields: [universityId], references: [id], onDelete: SetNull)
  department       Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  program          AcademicProgram?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  skills           StudentSkill[]
  applications     Application[]
  placements       Placement[]
  teamMemberships  TeamMember[]
  attendance       AttendanceRecord[]
  evaluations      EvaluationResult[]
  finalResults     FinalResult[]
  roomAllocations  RoomAllocation[]
  mealCard         MealCard?
  supportRequests  FinancialSupportRequest[]
  payments         Payment[]
  cvExtractions    CVExtraction[]
  skillAssessments SkillAssessment[]
  recommendations  InternshipRecommendation[]

  @@unique([universityId, studentNumber])
  @@index([departmentId, programId])
}

model CompanyProfile {
  id             String               @id @default(cuid())
  userId         String               @unique
  organizationId String
  companyName    String               @db.Text
  website        String?              @db.Text
  industry       String?              @db.Text
  description    String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verification   CompanyVerification?

  @@unique([organizationId])
  @@index([industry])
}

model CompanyVerification {
  id                 String             @id @default(cuid())
  companyProfileId   String             @unique
  status             VerificationStatus @default(PENDING)
  evidenceDocumentId String?
  notes              String?            @db.Text
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  companyProfile     CompanyProfile     @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  evidenceDocument   Document?          @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Text
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model LoginSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.Text
  device    String?   @db.Text
  ipAddress String?   @db.Text
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Institution structure (8)
model University {
  id             String            @id @default(cuid())
  organizationId String            @unique
  name           String            @db.VarChar(200)
  country        String?           @db.VarChar(100)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  faculties      Faculty[]
  programs       AcademicProgram[]
  academicYears  AcademicYear[]
  students       StudentProfile[]

  @@index([name])
}

model Faculty {
  id           String            @id @default(cuid())
  universityId String
  name         String            @db.VarChar(160)
  code         String?           @db.VarChar(40)
  createdAt    DateTime          @default(now())
  university   University        @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programs     AcademicProgram[]

  @@unique([universityId, name])
  @@unique([universityId, code])
}

model AcademicProgram {
  id           String           @id @default(cuid())
  universityId String
  facultyId    String?
  departmentId String?
  name         String           @db.VarChar(160)
  code         String?          @db.VarChar(40)
  degreeLevel  String?          @db.VarChar(40)
  createdAt    DateTime         @default(now())
  university   University       @relation(fields: [universityId], references: [id], onDelete: Restrict)
  faculty      Faculty?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  students     StudentProfile[]

  @@unique([universityId, name])
  @@index([facultyId, departmentId])
}

model AcademicYear {
  id           String     @id @default(cuid())
  universityId String
  name         String     @db.VarChar(40)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime   @default(now())
  university   University @relation(fields: [universityId], references: [id], onDelete: Restrict)
  semesters    Semester[]

  @@unique([universityId, name])
  @@index([universityId, startsAt, endsAt])
}

model Semester {
  id             String       @id @default(cuid())
  academicYearId String
  name           String       @db.VarChar(80)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime     @default(now())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, name])
  @@index([startsAt, endsAt])
}

model DepartmentAdvisor {
  id           String     @id @default(cuid())
  departmentId String
  advisorId    String
  startsAt     DateTime   @default(now())
  endsAt       DateTime?
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  advisor      User       @relation(fields: [advisorId], references: [id], onDelete: Restrict)

  @@unique([departmentId, advisorId, startsAt])
  @@index([advisorId, endsAt])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String           @db.VarChar(320)
  role           RoleName
  tokenHash      String           @unique @db.VarChar(255)
  status         InvitationStatus @default(PENDING)
  invitedById    String
  invitedUserId  String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy      User             @relation("OrgInviteSender", fields: [invitedById], references: [id], onDelete: Restrict)
  invitedUser    User?            @relation("OrgInviteRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([email, status])
}

model OrganizationSetting {
  id             String       @id @default(cuid())
  organizationId String
  key            String       @db.VarChar(120)
  value          Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// Internship programs and applications (13)
model InternshipProgram {
  id                  String               @id @default(cuid())
  organizationId      String
  createdById         String
  title               String               @db.VarChar(200)
  description         String               @db.Text
  status              InternshipStatus     @default(DRAFT)
  startsAt            DateTime?
  endsAt              DateTime?
  applicationDeadline DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy           User                 @relation("ProgramCreator", fields: [createdById], references: [id], onDelete: Restrict)
  positions           InternshipPosition[]
  applications        Application[]
  invitations         Invitation[]
  eligibilityRules    EligibilityRule[]

  @@unique([id, organizationId])
  @@index([organizationId, status, applicationDeadline])
}

model InternshipPosition {
  id               String                     @id @default(cuid())
  programId        String
  title            String                     @db.VarChar(200)
  description      String                     @db.Text
  openings         Int                        @default(1)
  status           InternshipStatus           @default(DRAFT)
  location         String?                    @db.VarChar(200)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  program          InternshipProgram          @relation(fields: [programId], references: [id], onDelete: Restrict)
  skills           InternshipSkill[]
  applications     Application[]
  eligibilityRules EligibilityRule[]
  interviews       Interview[]
  placements       Placement[]
  recommendations  InternshipRecommendation[]

  @@unique([id, programId])
  @@index([programId, status])
}

model InternshipSkill {
  id               String             @id @default(cuid())
  positionId       String
  skillId          String
  required         Boolean            @default(true)
  proficiencyLevel Int?
  position         InternshipPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill            Skill              @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([positionId, skillId])
  @@index([skillId])
}

model Skill {
  id                     String            @id @default(cuid())
  name                   String            @unique @db.VarChar(120)
  category               String?           @db.VarChar(100)
  createdAt              DateTime          @default(now())
  internshipRequirements InternshipSkill[]
  studentSkills          StudentSkill[]
  assessments            SkillAssessment[]

  @@index([category, name])
}

model StudentSkill {
  id                 String         @id @default(cuid())
  studentProfileId   String
  skillId            String
  proficiencyLevel   Int
  evidenceDocumentId String?
  verifiedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  studentProfile     StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill              Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)
  evidenceDocument   Document?      @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)

  @@unique([studentProfileId, skillId])
  @@index([skillId, proficiencyLevel])
}

model Application {
  id                String                     @id @default(cuid())
  organizationId    String
  programId         String
  studentProfileId  String
  positionId        String
  submittedById     String?
  status            ApplicationStatus          @default(DRAFT)
  coverLetter       String?                    @db.Text
  submittedAt       DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile    StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  program           InternshipProgram          @relation(fields: [programId, organizationId], references: [id, organizationId], onDelete: Restrict)
  position          InternshipPosition         @relation(fields: [positionId, programId], references: [id, programId], onDelete: Restrict)
  submittedBy       User?                      @relation("ApplicationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  documents         ApplicationDocument[]
  history           ApplicationStatusHistory[]
  eligibilityChecks EligibilityCheck[]
  interviews        Interview[]
  invitation        Invitation?
  placement         Placement?

  @@unique([studentProfileId, positionId])
  @@unique([id, positionId, studentProfileId, organizationId])
  @@unique([id, positionId])
  @@index([organizationId, status, submittedAt])
  @@index([positionId, status])
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  documentId    String
  documentType  String      @db.VarChar(80)
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([applicationId, documentId])
  @@index([documentId])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?            @db.Text
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  changedBy     User?              @relation("ApplicationStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

model EligibilityRule {
  id             String              @id @default(cuid())
  organizationId String
  programId      String?
  positionId     String?
  name           String              @db.VarChar(160)
  ruleDefinition Json
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  program        InternshipProgram?  @relation(fields: [programId], references: [id], onDelete: Cascade)
  position       InternshipPosition? @relation(fields: [positionId], references: [id], onDelete: Cascade)
  checks         EligibilityCheck[]

  @@unique([organizationId, name])
  @@index([programId, isActive])
  @@index([positionId, isActive])
}

model EligibilityCheck {
  id            String            @id @default(cuid())
  applicationId String
  ruleId        String
  status        EligibilityStatus @default(PENDING)
  result        Json?
  checkedAt     DateTime          @default(now())
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rule          EligibilityRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@unique([applicationId, ruleId])
  @@index([status, checkedAt])
}

model Invitation {
  id            String            @id @default(cuid())
  programId     String
  applicationId String?           @unique
  senderId      String
  recipientId   String
  status        InvitationStatus  @default(PENDING)
  message       String?           @db.Text
  expiresAt     DateTime
  respondedAt   DateTime?
  createdAt     DateTime          @default(now())
  program       InternshipProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  application   Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  sender        User              @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient     User              @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, status, expiresAt])
  @@index([programId, status])
}

model Interview {
  id            String             @id @default(cuid())
  applicationId String
  positionId    String
  interviewerId String
  inviteeId     String
  status        InterviewStatus    @default(SCHEDULED)
  startsAt      DateTime
  endsAt        DateTime
  location      String?            @db.VarChar(500)
  meetingUrl    String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  application   Application        @relation(fields: [applicationId, positionId], references: [id, positionId], onDelete: Restrict, map: "Interview_applicationPosition_fkey")
  position      InternshipPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)
  interviewer   User               @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: Restrict)
  invitee       User               @relation("InterviewInvitee", fields: [inviteeId], references: [id], onDelete: Restrict)
  feedback      InterviewFeedback?

  @@index([interviewerId, startsAt])
  @@index([inviteeId, startsAt])
  @@index([applicationId, status])
}

model InterviewFeedback {
  id          String    @id @default(cuid())
  interviewId String    @unique
  rating      Int?
  notes       String?   @db.Text
  submittedAt DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

// Placement, teams and supervision (11)
model Placement {
  id                    String                    @id @default(cuid())
  organizationId        String
  applicationId         String                    @unique
  positionId            String
  studentProfileId      String
  status                PlacementStatus           @default(ACTIVE)
  startsAt              DateTime
  endsAt                DateTime
  completedAt           DateTime?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  application           Application               @relation(fields: [applicationId, positionId, studentProfileId, organizationId], references: [id, positionId, studentProfileId, organizationId], onDelete: Restrict, map: "Placement_applicationPositionStudent_fkey")
  position              InternshipPosition        @relation(fields: [positionId], references: [id], onDelete: Restrict)
  studentProfile        StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  agreement             InternshipAgreement?
  team                  InternshipTeam?
  documentationPlan     DocumentationPlan?
  milestones            ImplementationMilestone[]
  submissions           Submission[]
  evaluations           EvaluationResult[]
  meetings              Meeting[]
  presentationSchedules PresentationSchedule[]
  finalResult           FinalResult?

  @@unique([applicationId, positionId, studentProfileId])
  @@unique([id, studentProfileId])
  @@unique([applicationId, positionId, studentProfileId, organizationId], map: "Placement_application_org_key")
  @@unique([id, organizationId])
  @@unique([id, studentProfileId, organizationId])
  @@index([organizationId, status, startsAt])
  @@index([studentProfileId, status])
}

model InternshipAgreement {
  id          String    @id @default(cuid())
  placementId String    @unique
  documentId  String?   @unique
  signedAt    DateTime?
  createdAt   DateTime  @default(now())
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Restrict)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}

model InternshipTeam {
  id             String              @id @default(cuid())
  organizationId String
  placementId    String              @unique
  name           String              @db.VarChar(160)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement      Placement           @relation(fields: [placementId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "InternshipTeam_placementOrganization_fkey")
  members        TeamMember[]
  advisors       AdvisorAssignment[]
  tasks          TeamTask[]
  meetings       Meeting[]

  @@unique([placementId, organizationId])
  @@index([organizationId])
}

model TeamMember {
  id               String         @id @default(cuid())
  teamId           String
  studentProfileId String
  joinedAt         DateTime       @default(now())
  leftAt           DateTime?
  team             InternshipTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([teamId, studentProfileId])
  @@index([studentProfileId, leftAt])
}

model AdvisorAssignment {
  id         String         @id @default(cuid())
  teamId     String
  advisorId  String
  assignedAt DateTime       @default(now())
  endedAt    DateTime?
  team       InternshipTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  advisor    User           @relation(fields: [advisorId], references: [id], onDelete: Restrict)

  @@unique([teamId, advisorId, assignedAt])
  @@index([advisorId, endedAt])
}

model TeamTask {
  id          String           @id @default(cuid())
  teamId      String
  title       String           @db.VarChar(200)
  description String?          @db.Text
  status      TaskStatus       @default(TODO)
  assigneeId  String?
  creatorId   String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  team        InternshipTeam   @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([teamId, status, dueAt])
  @@index([assigneeId, status])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  task      TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  documentId String
  createdAt  DateTime @default(now())
  task       TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([taskId, documentId])
}

model Meeting {
  id             String               @id @default(cuid())
  organizationId String
  placementId    String?
  teamId         String?
  creatorId      String
  title          String               @db.VarChar(200)
  startsAt       DateTime
  endsAt         DateTime
  location       String?              @db.VarChar(500)
  meetingUrl     String?              @db.VarChar(1000)
  status         MeetingStatus        @default(SCHEDULED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement      Placement?           @relation(fields: [placementId], references: [id], onDelete: Restrict)
  team           InternshipTeam?      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  creator        User                 @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  participants   MeetingParticipant[]
  attendance     AttendanceRecord[]

  @@index([organizationId, startsAt, status])
}

model MeetingParticipant {
  id          String    @id @default(cuid())
  meetingId   String
  userId      String
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId])
  @@index([userId, respondedAt])
}

model AttendanceRecord {
  id               String         @id @default(cuid())
  meetingId        String
  studentProfileId String
  present          Boolean        @default(false)
  checkedInAt      DateTime?
  note             String?        @db.Text
  meeting          Meeting        @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([meetingId, studentProfileId])
  @@index([studentProfileId])
}

// Submissions and evaluations (10)
model DocumentationPlan {
  id             String               @id @default(cuid())
  organizationId String
  placementId    String               @unique
  title          String               @db.VarChar(200)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement      Placement            @relation(fields: [placementId], references: [id], onDelete: Restrict)
  entries        DocumentationEntry[]

  @@index([organizationId])
}

model DocumentationEntry {
  id         String            @id @default(cuid())
  planId     String
  title      String            @db.VarChar(200)
  body       String?           @db.Text
  documentId String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  plan       DocumentationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  document   Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
}

model ImplementationMilestone {
  id             String       @id @default(cuid())
  organizationId String
  placementId    String
  title          String       @db.VarChar(200)
  description    String?      @db.Text
  dueAt          DateTime?
  completedAt    DateTime?
  sortOrder      Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement      Placement    @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@unique([placementId, sortOrder])
  @@index([organizationId, dueAt])
}

model Submission {
  id                String              @id @default(cuid())
  organizationId    String
  placementId       String
  title             String              @db.VarChar(200)
  status            SubmissionStatus    @default(DRAFT)
  submittedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement         Placement           @relation(fields: [placementId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "Submission_placementOrganization_fkey")
  versions          SubmissionVersion[]
  reviews           Review[]
  evaluationResults EvaluationResult[]

  @@unique([id, placementId])
  @@index([organizationId, status, submittedAt])
  @@index([placementId, status])
}

model SubmissionVersion {
  id           String     @id @default(cuid())
  submissionId String
  version      Int
  documentId   String
  checksum     String?    @db.VarChar(128)
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([submissionId, version])
  @@unique([submissionId, documentId])
}

model Review {
  id           String            @id @default(cuid())
  submissionId String
  rubricId     String?
  status       ReviewStatus      @default(PENDING)
  score        Decimal?          @db.Decimal(7, 2)
  summary      String?           @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  rubric       EvaluationRubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  comments     ReviewComment[]
  result       EvaluationResult?

  @@unique([id, submissionId])
  @@index([submissionId, status])
  @@index([rubricId])
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author    User?    @relation("ReviewCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
}

model EvaluationRubric {
  id             String                @id @default(cuid())
  organizationId String
  name           String                @db.VarChar(180)
  version        Int                   @default(1)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  criteria       EvaluationCriterion[]
  reviews        Review[]

  @@unique([organizationId, name, version])
  @@index([organizationId, isActive])
}

model EvaluationCriterion {
  id          String             @id @default(cuid())
  rubricId    String
  name        String             @db.VarChar(180)
  description String?            @db.Text
  maxScore    Decimal            @db.Decimal(7, 2)
  weight      Decimal            @default(1) @db.Decimal(7, 4)
  sortOrder   Int
  rubric      EvaluationRubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  results     EvaluationResult[]

  @@unique([rubricId, name])
  @@unique([rubricId, sortOrder])
}

model EvaluationResult {
  id               String               @id @default(cuid())
  reviewId         String               @unique
  submissionId     String
  placementId      String
  studentProfileId String
  criterionId      String?
  score            Decimal              @db.Decimal(7, 2)
  feedback         String?              @db.Text
  publishedAt      DateTime?
  createdAt        DateTime             @default(now())
  review           Review               @relation(fields: [reviewId, submissionId], references: [id, submissionId], onDelete: Restrict)
  submission       Submission           @relation(fields: [submissionId, placementId], references: [id, placementId], onDelete: Restrict)
  placement        Placement            @relation(fields: [placementId, studentProfileId], references: [id, studentProfileId], onDelete: Restrict, map: "EvaluationResult_placementStudent_fkey")
  studentProfile   StudentProfile       @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  criterion        EvaluationCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)

  @@unique([reviewId, submissionId])
  @@index([placementId, publishedAt])
  @@index([studentProfileId, publishedAt])
}

// Documents, verification and final presentations (10)
model Document {
  id                   String                 @id @default(cuid())
  organizationId       String
  ownerUserId          String
  storageKey           String                 @unique @db.VarChar(500)
  originalName         String                 @db.VarChar(255)
  mimeType             String                 @db.VarChar(160)
  sizeBytes            BigInt
  checksum             String?                @db.VarChar(128)
  status               DocumentStatus         @default(UPLOADED)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner                User                   @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  versions             DocumentVersion[]
  companyVerifications CompanyVerification[]
  studentSkillEvidence StudentSkill[]
  accessGrants         DocumentAccessGrant[]
  verifications        DocumentVerification[]
  applicationLinks     ApplicationDocument[]
  taskAttachments      TaskAttachment[]
  entries              DocumentationEntry[]
  submissionVersions   SubmissionVersion[]
  agreements           InternshipAgreement[]
  officialDocument     OfficialDocument?
  generatedDocument    GeneratedDocument?
  cvExtractions        CVExtraction[]
  messages             Message[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([ownerUserId, createdAt])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  storageKey String   @unique @db.VarChar(500)
  checksum   String?  @db.VarChar(128)
  sizeBytes  BigInt
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
}

model DocumentAccessGrant {
  id          String    @id @default(cuid())
  documentId  String
  grantedToId String
  grantedById String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  document    Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  grantedTo   User      @relation("GrantRecipient", fields: [grantedToId], references: [id], onDelete: Restrict)
  grantedBy   User      @relation("GrantCreator", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([documentId, grantedToId])
  @@index([grantedToId, expiresAt, revokedAt])
}

model DocumentVerification {
  id         String             @id @default(cuid())
  documentId String
  verifierId String?
  status     VerificationStatus @default(PENDING)
  notes      String?            @db.Text
  verifiedAt DateTime?
  createdAt  DateTime           @default(now())
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Restrict)
  verifier   User?              @relation("DocumentVerifier", fields: [verifierId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([status, createdAt])
}

model OfficialDocument {
  id             String       @id @default(cuid())
  organizationId String
  documentId     String       @unique
  issuedById     String
  documentNumber String       @unique @db.VarChar(100)
  issuedAt       DateTime     @default(now())
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  issuedBy       User         @relation("OfficialDocumentIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([organizationId, issuedAt])
}

model GeneratedDocument {
  id             String       @id @default(cuid())
  organizationId String
  documentId     String       @unique
  templateKey    String       @db.VarChar(120)
  requestedById  String
  generatedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  requestedBy    User         @relation("GeneratedDocumentRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId, generatedAt])
}

model PresentationSchedule {
  id             String                    @id @default(cuid())
  organizationId String
  placementId    String
  scheduledById  String
  startsAt       DateTime
  endsAt         DateTime
  location       String?                   @db.VarChar(500)
  status         PresentationStatus        @default(SCHEDULED)
  createdAt      DateTime                  @default(now())
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement      Placement                 @relation(fields: [placementId], references: [id], onDelete: Restrict)
  scheduledBy    User                      @relation("PresentationScheduler", fields: [scheduledById], references: [id], onDelete: Restrict)
  panel          PresentationPanelMember[]
  result         PresentationResult?

  @@index([organizationId, startsAt, status])
  @@index([placementId, startsAt])
}

model PresentationPanelMember {
  id         String               @id @default(cuid())
  scheduleId String
  userId     String
  schedule   PresentationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, userId])
}

model PresentationResult {
  id          String               @id @default(cuid())
  scheduleId  String               @unique
  score       Decimal?             @db.Decimal(7, 2)
  feedback    String?              @db.Text
  finalizedAt DateTime?
  schedule    PresentationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
}

model FinalResult {
  id               String         @id @default(cuid())
  organizationId   String
  placementId      String         @unique
  studentProfileId String
  outcome          String         @db.VarChar(80)
  finalScore       Decimal?       @db.Decimal(7, 2)
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placement        Placement      @relation(fields: [placementId, studentProfileId, organizationId], references: [id, studentProfileId, organizationId], onDelete: Restrict, map: "FinalResult_placementStudentOrg_fkey")
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)

  @@unique([placementId, studentProfileId, organizationId])
  @@index([organizationId, publishedAt])
  @@index([studentProfileId, publishedAt])
}

// Student services and finance (9)
model Dormitory {
  id             String         @id @default(cuid())
  organizationId String
  name           String         @db.VarChar(160)
  address        String?        @db.Text
  managerId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manager        User?          @relation(fields: [managerId], references: [id], onDelete: SetNull)
  rooms          Room[]
  keys           DormitoryKey[]

  @@unique([organizationId, name])
}

model Room {
  id          String           @id @default(cuid())
  dormitoryId String
  roomNumber  String           @db.VarChar(40)
  capacity    Int              @default(1)
  floor       Int?
  createdAt   DateTime         @default(now())
  dormitory   Dormitory        @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  allocations RoomAllocation[]

  @@unique([dormitoryId, roomNumber])
  @@index([dormitoryId, floor])
}

model RoomAllocation {
  id               String           @id @default(cuid())
  roomId           String
  studentProfileId String
  status           AllocationStatus @default(RESERVED)
  startsAt         DateTime
  endsAt           DateTime
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  createdAt        DateTime         @default(now())
  room             Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  keyCheckouts     KeyCheckout[]

  @@index([roomId, status, startsAt, endsAt])
  @@index([studentProfileId, status])
}

model DormitoryKey {
  id          String        @id @default(cuid())
  dormitoryId String
  keyCode     String        @db.VarChar(80)
  isActive    Boolean       @default(true)
  dormitory   Dormitory     @relation(fields: [dormitoryId], references: [id], onDelete: Restrict)
  checkouts   KeyCheckout[]

  @@unique([dormitoryId, keyCode])
}

model KeyCheckout {
  id             String            @id @default(cuid())
  keyId          String
  allocationId   String
  checkedOutById String
  status         KeyCheckoutStatus @default(CHECKED_OUT)
  checkedOutAt   DateTime          @default(now())
  returnedAt     DateTime?
  key            DormitoryKey      @relation(fields: [keyId], references: [id], onDelete: Restrict)
  allocation     RoomAllocation    @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  checkedOutBy   User              @relation(fields: [checkedOutById], references: [id], onDelete: Restrict)

  @@index([keyId, status])
  @@index([allocationId, status])
}

model MealCard {
  id               String            @id @default(cuid())
  organizationId   String
  studentProfileId String            @unique
  cardNumberHash   String            @unique @db.VarChar(255)
  isActive         Boolean           @default(true)
  issuedAt         DateTime          @default(now())
  revokedAt        DateTime?
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  transactions     MealTransaction[]

  @@index([organizationId, isActive])
}

model MealTransaction {
  id            String   @id @default(cuid())
  mealCardId    String
  merchant      String   @db.VarChar(160)
  amount        Decimal  @db.Decimal(12, 2)
  occurredAt    DateTime @default(now())
  referenceHash String?  @unique @db.VarChar(255)
  mealCard      MealCard @relation(fields: [mealCardId], references: [id], onDelete: Restrict)

  @@index([mealCardId, occurredAt])
}

model FinancialSupportRequest {
  id               String         @id @default(cuid())
  organizationId   String
  studentProfileId String
  status           SupportStatus  @default(SUBMITTED)
  requestedAmount  Decimal        @db.Decimal(12, 2)
  approvedAmount   Decimal?       @db.Decimal(12, 2)
  currency         String         @default("USD") @db.Char(3)
  reason           String         @db.Text
  reviewerId       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  reviewer         User?          @relation("SupportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  payments         Payment[]

  @@unique([id, studentProfileId, organizationId])
  @@index([organizationId, status, createdAt])
  @@index([studentProfileId, status])
}

model Payment {
  id                    String                   @id @default(cuid())
  organizationId        String
  studentProfileId      String
  supportRequestId      String?
  amount                Decimal                  @db.Decimal(12, 2)
  currency              String                   @default("USD") @db.Char(3)
  status                PaymentStatus            @default(PENDING)
  providerReferenceHash String?                  @unique @db.VarChar(255)
  paidAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile        StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  supportRequest        FinancialSupportRequest? @relation(fields: [supportRequestId, studentProfileId, organizationId], references: [id, studentProfileId, organizationId], onDelete: Restrict, map: "Payment_supportRequestContext_fkey")

  @@index([organizationId, status, createdAt])
  @@index([studentProfileId, status])
}

// Communication, reporting and audit (7)
model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(PENDING)
  title          String              @db.VarChar(200)
  body           String              @db.Text
  readAt         DateTime?
  scheduledAt    DateTime            @default(now())
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, scheduledAt])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  inAppEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id             String                    @id @default(cuid())
  organizationId String
  createdById    String
  subject        String?                   @db.VarChar(200)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  closedAt       DateTime?
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  participants   ConversationParticipant[]
  messages       Message[]

  @@index([organizationId, updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  leftAt         DateTime?
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  body           String?      @db.Text
  documentId     String?
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  document       Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model ReportDefinition {
  id             String       @id @default(cuid())
  organizationId String
  createdById    String
  name           String       @db.VarChar(160)
  specification  Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String        @db.VarChar(120)
  entityType     String        @db.VarChar(120)
  entityId       String?       @db.VarChar(120)
  requestId      String?       @db.VarChar(120)
  metadata       Json?
  occurredAt     DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([requestId])
}

// Internal AI and operational records (5); AI has no user/actor role.
model CVExtraction {
  id               String         @id @default(cuid())
  organizationId   String
  studentProfileId String
  documentId       String
  requestedById    String
  status           AIJobStatus    @default(QUEUED)
  extractedData    Json?
  modelVersion     String?        @db.VarChar(100)
  errorCode        String?        @db.VarChar(80)
  createdAt        DateTime       @default(now())
  completedAt      DateTime?
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  document         Document       @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "CVExtraction_documentOrganization_fkey")
  requestedBy      User           @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([studentProfileId, createdAt])
}

model SkillAssessment {
  id               String         @id @default(cuid())
  organizationId   String
  studentProfileId String
  skillId          String?
  reviewedById     String?
  score            Decimal?       @db.Decimal(7, 2)
  confidence       Decimal?       @db.Decimal(5, 4)
  evidence         Json?
  modelVersion     String?        @db.VarChar(100)
  assessedAt       DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  skill            Skill?         @relation(fields: [skillId], references: [id], onDelete: SetNull)
  reviewedBy       User?          @relation("AssessmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, assessedAt])
  @@index([studentProfileId, skillId, assessedAt])
}

model InternshipRecommendation {
  id               String             @id @default(cuid())
  organizationId   String
  studentProfileId String
  positionId       String
  score            Decimal            @db.Decimal(7, 4)
  explanation      String?            @db.Text
  modelVersion     String             @db.VarChar(100)
  generatedAt      DateTime           @default(now())
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Restrict)
  position         InternshipPosition @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, positionId, modelVersion])
  @@index([organizationId, studentProfileId, score(sort: Desc)])
}

model AIJob {
  id              String        @id @default(cuid())
  organizationId  String?
  requestedById   String?
  type            AIJobType
  status          AIJobStatus   @default(QUEUED)
  inputReference  String?       @db.VarChar(500)
  resultReference String?       @db.VarChar(500)
  errorCode       String?       @db.VarChar(80)
  createdAt       DateTime      @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  requestedBy     User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([type, status, createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(160)
  value       Json
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
