NODE_ENV=development
PORT=3001
# The API loads DATABASE_URL and DIRECT_URL from packages/database/.env.
# DATABASE_URL should use Neon's pooled endpoint; DIRECT_URL is for migrations.
REDIS_URL=redis://:internlink@localhost:6379
JWT_SECRET=super-secret-change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=7d
SWAGGER_TITLE=InternLink API
SWAGGER_DESCRIPTION=University internship platform API
SWAGGER_VERSION=1.0
LOG_LEVEL=info
AI_SERVICE_URL=http://localhost:8000
