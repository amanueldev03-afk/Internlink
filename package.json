{
  "name": "internlink-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "pnpm --dir apps/api start:dev",
    "dev:worker": "pnpm --dir apps/worker dev",
    "build:web": "pnpm --dir apps/web build",
    "build:api": "pnpm --dir apps/api build",
    "build:worker": "pnpm --dir apps/worker build",
    "lint": "pnpm -r --parallel lint",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.11.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.0"
  }
}
